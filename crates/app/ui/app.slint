// KeRo Smarter Download – user interface (Slint)
// Classic download-manager layout: menu bar, big icon toolbar, category and
// queue tree, detailed list, one progress window per download. Nine themes.

import { Button, LineEdit, SpinBox, ComboBox, ListView, TabWidget, TextEdit, Palette } from "std-widgets.slint";
import { ToolTip, DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme, ThemedWindow, CaptionButton, P, Icon, G, TypeIcon, BigTypeIcon, ToolBtn, ToolSeparator, TreeItem, HeaderCell, Cell, MenuEntry, MenuSep, MenuLabel, Glyph, HRow, CheckBox } from "common.slint";
import { ProgressAction, ProgressMetric } from "progress-style.slint";
export { DownloadRow, QueueRow, SegView, Cols, ColDef, CatRow, PairRow, LinkRow, Theme }
export { FloatingDownload } from "floating.slint";
export { BrowserRow } from "dialogs.slint";
export { ConfirmDialog, ColumnsDialog, CategoryDialog, FindDialog, PropertiesDialog, DuplicateDialog, CountdownDialog, SchedulerDialog, GrabberDialog, TipDialog, RefreshDialog, SettingsDialog, PlaylistDialog, TorrentDialog, BrowserDialog, AboutDialog, UpdateDialog, WhatsNewDialog } from "dialogs.slint";

component DownloadItem inherits Rectangle {
    in property <DownloadRow> data;
    in property <bool> selected;
    in property <[QueueRow]> queues;
    in property <Cols> cols;
    in property <[ColDef]> columns;
    // how many downloads are selected (the menu then works on all of them)
    in property <int> sel-count;
    // click with Ctrl / Shift
    callback pick(bool, bool);
    // right click: keep a multiple selection that includes this row
    callback right-pick();
    // dragging with the mouse held down: rows below (+) or above (-) this one
    callback drag(int);
    property <int> drag-last;
    callback activated();
    callback action(string);
    callback move-to-queue(int);
    // dragging a finished file out of the program (onto the desktop, a folder…)
    callback drag-out();
    property <bool> dragged-out;
    height: max(24px, 24px * Theme.font-scale);
    // as wide as all the columns (the list then scrolls sideways)
    out property <length> content-w: cells.min-width;
    // wide columns: the row is wider than the list. The look and the mouse
    // cover all of it (in Arabic the name is on the far right side of it)
    Rectangle {
        x: 0px;
        width: cells.width;
        height: parent.height;
        background: root.selected ? Theme.select : ta.has-hover ? Theme.hover : transparent;
        border-width: root.selected ? 1px : 0px;
        border-color: Theme.select-line;
    }
    ta := TouchArea {
        x: 0px;
        width: cells.width;
        height: parent.height;
        double-clicked => {
            root.activated();
        }
        moved => {
            // a finished file pulled sideways: hand it to Windows to drop elsewhere
            if (self.pressed && root.done && !root.dragged-out && abs(self.mouse-x - self.pressed-x) > 24px && abs(self.mouse-x - self.pressed-x) > 2 * abs(self.mouse-y - self.pressed-y)) {
                root.dragged-out = true;
                root.drag-out();
                return;
            }
            if (self.pressed && floor(self.mouse-y / root.height) != root.drag-last) {
                root.drag-last = floor(self.mouse-y / root.height);
                root.drag(root.drag-last);
            }
        }
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.drag-last = 0;
                root.dragged-out = false;
                root.pick(ev.modifiers.control, ev.modifiers.shift);
            }
            // right click: select the row and open the menu where the mouse is
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.right-pick();
                root.menu-x = self.mouse-x;
                root.menu-y = self.mouse-y;
                menu.show();
            }
        }
    }
    property <length> menu-x;
    property <length> menu-y;
    property <bool> done: root.data.state == 3;
    property <bool> can-resume: root.data.state == 2 || root.data.state == 4;
    property <bool> can-stop: root.data.state == 0 || root.data.state == 1;
    menu := PopupWindow {
        // Arabic: the menu opens to the left of the mouse
        x: Theme.rtl ? max(0px, root.menu-x - 260px) : root.menu-x;
        y: root.menu-y;
        width: 260px;
        height: menu-list.preferred-height;
        Rectangle {
            width: parent.width;
            height: menu-list.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 3px;
            menu-list := VerticalLayout {
                padding: 4px;
                spacing: 0px;
                if root.sel-count > 1: MenuLabel {
                    text: @tr("{} downloads selected", root.sel-count);
                }
                MenuEntry {
                    text: root.done ? @tr("Open") : @tr("Show download progress");
                    glyph: root.done ? "play" : "progress";
                    bold: true;
                    clicked => {
                        root.activated();
                    }
                }
                MenuEntry {
                    text: @tr("Open with…");
                    glyph: "openwith";
                    enabled: root.done;
                    clicked => {
                        root.action("openwith");
                    }
                }
                if !root.done && (root.data.kind == "video" || root.data.kind == "audio"): MenuEntry {
                    text: @tr("Play while downloading");
                    glyph: "play";
                    glyph-color: #d6631d;
                    clicked => {
                        root.action("preview");
                    }
                }
                MenuEntry {
                    text: @tr("Open folder");
                    glyph: "folder";
                    clicked => {
                        root.action("folder");
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Resume download");
                    glyph: "play";
                    glyph-color: #2e9e4f;
                    enabled: root.can-resume || root.sel-count > 1;
                    clicked => {
                        root.action("resume");
                    }
                }
                MenuEntry {
                    text: @tr("Stop download");
                    glyph: "pause";
                    glyph-color: #e08a00;
                    enabled: root.can-stop || root.sel-count > 1;
                    clicked => {
                        root.action("stop");
                    }
                }
                MenuEntry {
                    text: @tr("Redownload");
                    glyph: "redo";
                    clicked => {
                        root.action("restart");
                    }
                }
                MenuEntry {
                    text: @tr("Refresh download address…");
                    glyph: "refresh";
                    enabled: !root.done;
                    clicked => {
                        root.action("refresh");
                    }
                }
                MenuEntry {
                    text: @tr("Move / Rename…");
                    glyph: "edit";
                    clicked => {
                        root.action("move");
                    }
                }
                MenuSep { }
                MenuLabel {
                    text: @tr("Move to queue");
                }
                for q in root.queues: MenuEntry {
                    text: q.name;
                    glyph: root.data.queue == q.id ? "check" : "";
                    indent: true;
                    clicked => {
                        root.move-to-queue(q.id);
                    }
                }
                MenuEntry {
                    text: @tr("Delete from queue");
                    indent: true;
                    enabled: root.data.queue != "";
                    clicked => {
                        root.move-to-queue(-1);
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Copy address");
                    glyph: "copy";
                    clicked => {
                        root.action("copy");
                    }
                }
                MenuEntry {
                    text: @tr("Check file (SHA-256)");
                    glyph: "hash";
                    enabled: root.done;
                    clicked => {
                        root.action("sha256");
                    }
                }
                MenuEntry {
                    text: @tr("Properties");
                    glyph: "info";
                    clicked => {
                        root.action("properties");
                    }
                }
                MenuSep { }
                MenuEntry {
                    text: @tr("Remove");
                    glyph: "close";
                    glyph-color: #e0443b;
                    clicked => {
                        root.action("delete");
                    }
                }
            }
        }
    }
    cells := HRow {
        padding-left: Theme.rtl ? (0px) : (6px);
        padding-right: Theme.rtl ? (6px) : (0px);
        spacing: 0px;
        Rectangle {
            width: 32px;
            TypeIcon {
                kind: root.data.kind;
                x: 4px;
                y: (parent.height - 18px) / 2;
            }
        }
        // the columns in the order and widths of the header
        for c in root.columns: Rectangle {
            width: c.width;
            // clip: long right-to-left (Arabic) names must never spill over
            clip: true;
            if c.key == "name": Cell {
                x: Theme.rtl ? 4px : 0px;
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.name;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            }
            if c.key == "q": Cell {
                width: parent.width;
                height: parent.height;
                text: root.data.queue;
                horizontal-alignment: center;
                color: Theme.accent;
            }
            if c.key == "size": Cell {
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.size;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            }
            if c.key == "status": Rectangle {
                // thin progress line under the status, for running downloads
                if root.data.state == 1 || (root.data.state == 2 && root.data.progress > 0): Rectangle {
                    x: 10px;
                    y: parent.height - 5px;
                    width: parent.width - 20px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.bar-bg;
                    Rectangle {
                        x: Theme.rtl ? parent.width - self.width : 0;
                        width: parent.width * root.data.progress;
                        height: parent.height;
                        border-radius: 1.5px;
                        background: root.data.state == 1 ? Theme.accent : Theme.warn;
                        animate width {
                            duration: 250ms;
                            easing: linear;
                        }
                    }
                }
                Cell {
                    width: parent.width;
                    height: parent.height - 2px;
                    text: root.data.status;
                    horizontal-alignment: center;
                    color: root.data.state == 3 ? Theme.ok : root.data.state == 4 ? Theme.err : root.data.state == 1 ? Theme.accent : Theme.text;
                }
            }
            if c.key == "eta": Cell {
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.eta;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            }
            if c.key == "speed": Cell {
                width: parent.width - 4px;
                height: parent.height;
                text: root.data.speed;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
            }
            if c.key == "last": Cell {
                width: parent.width;
                height: parent.height;
                text: root.data.last-try;
                horizontal-alignment: center;
                color: Theme.muted;
            }
            if c.key == "desc": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.description;
                color: Theme.muted;
            }
            if c.key == "added": Cell {
                width: parent.width;
                height: parent.height;
                text: root.data.added;
                horizontal-alignment: center;
                color: Theme.muted;
            }
            if c.key == "saveto": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.save-to;
                color: Theme.muted;
            }
            if c.key == "referer": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.referer;
                color: Theme.muted;
            }
            if c.key == "parent": Cell {
                width: parent.width;
                height: parent.height;
                text: "  " + root.data.parent;
                color: Theme.muted;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
}

// right click menu of the sidebar (categories and queues)
component TreeMenu inherits PopupWindow {
    in property <string> target;
    in property <bool> is-queue;
    in property <bool> builtin;
    callback chosen(string);
    width: 210px;
    height: tm-list.preferred-height;
    Rectangle {
        width: parent.width;
        height: tm-list.preferred-height;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 4px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000055;
        drop-shadow-offset-y: 3px;
        tm-list := VerticalLayout {
            padding: 4px;
            if root.is-queue: MenuEntry {
                text: @tr("Start queue");
                glyph: "play";
                glyph-color: #2e9e4f;
                clicked => {
                    root.chosen("start");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("Stop queue");
                glyph: "stop";
                glyph-color: #e0443b;
                clicked => {
                    root.chosen("stop");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("Edit queue / schedule…");
                glyph: "clock";
                clicked => {
                    root.chosen("edit");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("New queue…");
                glyph: "plus";
                clicked => {
                    root.chosen("new");
                }
            }
            if root.is-queue: MenuEntry {
                text: @tr("Delete queue");
                glyph: "close";
                glyph-color: #e0443b;
                enabled: !root.builtin;
                clicked => {
                    root.chosen("delete");
                }
            }
            if !root.is-queue: MenuEntry {
                text: @tr("Add category…");
                glyph: "plus";
                clicked => {
                    root.chosen("add");
                }
            }
            if !root.is-queue && root.target != "": MenuEntry {
                text: @tr("Delete category");
                glyph: "close";
                glyph-color: #e0443b;
                enabled: !root.builtin;
                clicked => {
                    root.chosen("delete");
                }
            }
            if !root.is-queue && root.target != "": MenuEntry {
                text: @tr("Properties…");
                glyph: "info";
                clicked => {
                    root.chosen("props");
                }
            }
        }
    }
}

// a sidebar item with its own right click menu
component CtxTreeItem inherits TreeItem {
    in property <bool> is-queue;
    in property <bool> builtin;
    in property <string> target;
    callback chosen(string);
    property <length> mx;
    property <length> my;
    context(x, y) => {
        self.mx = x;
        self.my = y;
        pm.show();
    }
    pm := TreeMenu {
        x: Theme.rtl ? max(0px, root.mx - 210px) : root.mx;
        y: root.my;
        target: root.target;
        is-queue: root.is-queue;
        builtin: root.builtin;
        chosen(a) => {
            root.chosen(a);
        }
    }
}

export component MainWindow inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("KeRo Smarter Download");
    // Options > General > Background picture (shows through the panels)
    in property <image> bg-image;
    in property <bool> has-bg-image;
    // the size the window opens with
    preferred-width: 960px;
    preferred-height: 500px;
    min-width: 700px;
    min-height: 380px;

    in property <[DownloadRow]> rows;
    in property <[QueueRow]> queues;
    in property <[CatRow]> categories;
    // counts: all, unfinished, finished
    in property <string> count-all;
    in property <string> count-unfinished;
    in property <string> count-finished;
    in-out property <int> selected-id: -1;
    // "all", "cat:Video", "unfinished", "unf:Video", "finished", "fin:Video", "queue:3"
    in-out property <string> view: "all";
    in-out property <string> search;
    in property <string> status-text;
    in property <string> limiter-text;
    in property <int> selected-state: -1;
    // multiple selection: how many, and whether any can be resumed / stopped
    in property <int> sel-count;
    in property <bool> can-resume;
    in property <bool> can-stop;
    in property <int> current-queue: 1;
    in property <bool> limiter-on;
    in property <bool> hide-categories;
    in property <string> sort-by: "date";
    in property <bool> sort-desc: true;
    // Downloads > When all downloads finish: 0 nothing, 1 shut down, 2 sleep, 3 exit, 4 hibernate
    in property <int> all-done: 0;
    in property <Cols> cols: { q: true, size: true, status: true, eta: true, speed: true, last: true, desc: true };
    in property <bool> toolbar-small;
    in property <string> language: "en";
    in-out property <bool> open-all: true;
    in-out property <bool> open-unf: false;
    in-out property <bool> open-fin: false;
    in-out property <bool> open-queues: true;

    callback add-url();
    callback add-batch();
    callback add-batch-clipboard();
    callback resume(int);
    callback pause(int);
    callback resume-all();
    callback stop-all();
    callback delete(int);
    callback delete-completed();
    callback open-settings(int);
    callback open-scheduler();
    callback open-limiter();
    callback toggle-limiter();
    callback start-queue(int);
    callback stop-queue(int);
    callback new-queue();
    callback edit-queue(int);
    callback delete-queue(int);
    callback view-changed(string);
    callback search-changed();
    callback sort(string);
    callback row-activated(int);
    callback row-clicked(int, bool, bool);
    callback row-right(int);
    callback row-drag(int, int);
    callback row-drag-out(int);
    // the list's columns (order + widths); dragging in the header changes them
    in property <[ColDef]> columns;
    callback column-resized(int, length);
    callback column-dropped(int, length);
    callback columns-changed();
    pure function col-title(k: string) -> string {
        if (k == "name") { return @tr("File Name"); }
        if (k == "q") { return @tr("Q"); }
        if (k == "size") { return @tr("Size"); }
        if (k == "status") { return @tr("Status"); }
        if (k == "eta") { return @tr("Time left"); }
        if (k == "speed") { return @tr("Transfer rate"); }
        if (k == "last") { return @tr("Last Try Date"); }
        if (k == "desc") { return @tr("Description"); }
        if (k == "added") { return @tr("Date Added"); }
        if (k == "saveto") { return @tr("Save To"); }
        if (k == "referer") { return @tr("Referer"); }
        if (k == "parent") { return @tr("Parent Web Page"); }
        return k;
    }
    pure function col-sort-key(k: string) -> string {
        if (k == "q") { return ""; }
        if (k == "last") { return "date"; }
        return k;
    }
    callback select-all();
    callback row-action(int, string);
    callback row-to-queue(int, int);
    callback open-download-folder();
    callback export-list(string);
    callback import-list(string);
    callback set-theme(int);
    callback set-language(string);
    callback toggle-categories();
    callback set-toolbar-small(bool);
    callback open-columns();
    callback update-tools();
    callback check-app-update();
    callback set-all-done(int);
    callback add-category();
    callback category-props(string);
    callback delete-category(string);
    callback find();
    callback find-next();
    callback grabber();
    callback playlist();
    callback torrent();
    callback browsers();
    callback about();
    callback quit();


    function category-menu(target: string, a: string) {
        if (a == "add") {
            root.add-category();
        } else if (a == "delete") {
            root.delete-category(target);
        } else if (a == "props") {
            root.category-props(target);
        }
    }
    function queue-menu-action(q: int, a: string) {
        if (a == "start") {
            root.start-queue(q);
        } else if (a == "stop") {
            root.stop-queue(q);
        } else if (a == "edit") {
            root.edit-queue(q);
        } else if (a == "new") {
            root.new-queue();
        } else if (a == "delete") {
            root.delete-queue(q);
        }
    }

    property <length> qmenu-x;
    property <bool> qmenu-start: true;
    queue-menu := PopupWindow {
        x: Theme.rtl ? max(0px, root.qmenu-x + 62px - 220px) : root.qmenu-x;
        y: 66px;
        width: 220px;
        height: qm-list.preferred-height;
        Rectangle {
            width: parent.width;
            height: qm-list.preferred-height;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000055;
            qm-list := VerticalLayout {
                padding: 4px;
                MenuLabel {
                    text: root.qmenu-start ? @tr("Start queue") : @tr("Stop queue");
                }
                for q in root.queues: MenuEntry {
                    text: q.name;
                    glyph: q.running ? "play" : "";
                    glyph-color: #2e9e4f;
                    indent: true;
                    clicked => {
                        if (root.qmenu-start) {
                            root.start-queue(q.id);
                        } else {
                            root.stop-queue(q.id);
                        }
                    }
                }
            }
        }
    }

    if root.has-bg-image: Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: root.bg-image;
        image-fit: cover;
    }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "a" || event.text == "A" || event.text == "ش")) {
                root.select-all();
                return accept;
            }
            if (event.text == Key.Delete && root.selected-id >= 0) {
                root.delete(root.selected-id);
                return accept;
            }
            if (event.text == Key.Return && root.selected-id >= 0) {
                root.row-activated(root.selected-id);
                return accept;
            }
            if (event.text == Key.F3) {
                root.find-next();
                return accept;
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F" || event.text == "ب")) {
                root.find();
                return accept;
            }
            if (event.modifiers.control && (event.text == "n" || event.text == "N" || event.text == "ى")) {
                root.add-url();
                return accept;
            }
            if (event.modifiers.control && (event.text == "b" || event.text == "B" || event.text == "لا")) {
                root.add-batch();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Language-aware top menu: HRow places the first heading at
            // the left in LTR and at the right in Arabic. Menu subtrees and
            // their actions are retained unchanged.
            Rectangle {
                height: 30px;
                background: Theme.panel;
                HRow {
                    padding-left: 4px; padding-right: 4px;
                    spacing: 1px;
                    menu-tasks := ContextMenuArea {
                        width: heading-tasks.preferred-width + 24px;
                        height: 28px;
                        Menu {
                            title: @tr("Tasks");
                            MenuItem {
                                title: @tr("Add new download…");
                                activated => {
                                    root.add-url();
                                }
                            }
                            MenuItem {
                                title: @tr("Add batch download…");
                                activated => {
                                    root.add-batch();
                                }
                            }
                            MenuItem {
                                title: @tr("Add batch download from clipboard");
                                activated => {
                                    root.add-batch-clipboard();
                                }
                            }
                            MenuItem {
                                title: @tr("Run site grabber…");
                                activated => {
                                    root.grabber();
                                }
                            }
                            MenuItem {
                                title: @tr("Download a playlist…");
                                activated => {
                                    root.playlist();
                                }
                            }
                            MenuItem {
                                title: @tr("Add a torrent / magnet link…");
                                activated => {
                                    root.torrent();
                                }
                            }
                            MenuSeparator { }
                            Menu {
                                title: @tr("Export");
                                MenuItem {
                                    title: @tr("To download list file (.ef2)…");
                                    activated => {
                                        root.export-list("ef2");
                                    }
                                }
                                MenuItem {
                                    title: @tr("To text file…");
                                    activated => {
                                        root.export-list("txt");
                                    }
                                }
                            }
                            Menu {
                                title: @tr("Import");
                                MenuItem {
                                    title: @tr("From download list file (.ef2)…");
                                    activated => {
                                        root.import-list("ef2");
                                    }
                                }
                                MenuItem {
                                    title: @tr("From text file…");
                                    activated => {
                                        root.import-list("txt");
                                    }
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Open download folder");
                                activated => {
                                    root.open-download-folder();
                                }
                            }
                            MenuItem {
                                title: @tr("Exit");
                                activated => {
                                    root.quit();
                                }
                            }
                        }
                        Rectangle {
                            background: touch-tasks.has-hover || focus-tasks.has-focus ? Theme.hover : transparent;
                            border-radius: 3px;
                            heading-tasks := Text {
                                text: @tr("Tasks");
                                color: Theme.text;
                                font-size: 13px * Theme.font-scale;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            focus-tasks := FocusScope {
                                accessible-role: button;
                                accessible-label: @tr("Tasks");
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == " " || event.text == Key.DownArrow) {
                                        menu-tasks.show({ x: 0px, y: menu-tasks.height });
                                        return accept;
                                    }
                                    reject
                                }
                                touch-tasks := TouchArea {
                                    clicked => {
                                        focus-tasks.focus();
                                        menu-tasks.show({ x: 0px, y: menu-tasks.height });
                                    }
                                }
                            }
                        }
                    }
                    menu-file := ContextMenuArea {
                        width: heading-file.preferred-width + 24px;
                        height: 28px;
                        Menu {
                            title: @tr("File");
                            MenuItem {
                                title: @tr("Download now");
                                enabled: root.can-resume;
                                activated => {
                                    root.resume(root.selected-id);
                                }
                            }
                            MenuItem {
                                title: @tr("Stop download");
                                enabled: root.can-stop;
                                activated => {
                                    root.pause(root.selected-id);
                                }
                            }
                            MenuItem {
                                title: @tr("Remove");
                                enabled: root.selected-id >= 0;
                                activated => {
                                    root.delete(root.selected-id);
                                }
                            }
                            MenuItem {
                                title: @tr("Redownload");
                                enabled: root.selected-id >= 0;
                                activated => {
                                    root.row-action(root.selected-id, "restart");
                                }
                            }
                            MenuItem {
                                title: @tr("Refresh download address…");
                                enabled: root.selected-id >= 0 && root.selected-state != 3;
                                activated => {
                                    root.row-action(root.selected-id, "refresh");
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Open");
                                enabled: root.selected-state == 3;
                                activated => {
                                    root.row-action(root.selected-id, "open");
                                }
                            }
                            MenuItem {
                                title: @tr("Open with…");
                                enabled: root.selected-state == 3;
                                activated => {
                                    root.row-action(root.selected-id, "openwith");
                                }
                            }
                            MenuItem {
                                title: @tr("Play while downloading");
                                enabled: root.selected-id >= 0 && root.selected-state != 3;
                                activated => {
                                    root.row-action(root.selected-id, "preview");
                                }
                            }
                            MenuItem {
                                title: @tr("Open folder");
                                enabled: root.selected-id >= 0;
                                activated => {
                                    root.row-action(root.selected-id, "folder");
                                }
                            }
                            MenuItem {
                                title: @tr("Move / Rename…");
                                enabled: root.selected-id >= 0;
                                activated => {
                                    root.row-action(root.selected-id, "move");
                                }
                            }
                            MenuItem {
                                title: @tr("Copy address");
                                enabled: root.selected-id >= 0;
                                activated => {
                                    root.row-action(root.selected-id, "copy");
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Select all   Ctrl+A");
                                activated => {
                                    root.select-all();
                                }
                            }
                            MenuItem {
                                title: @tr("Properties");
                                enabled: root.selected-id >= 0;
                                activated => {
                                    root.row-action(root.selected-id, "properties");
                                }
                            }
                        }
                        Rectangle {
                            background: touch-file.has-hover || focus-file.has-focus ? Theme.hover : transparent;
                            border-radius: 3px;
                            heading-file := Text {
                                text: @tr("File");
                                color: Theme.text;
                                font-size: 13px * Theme.font-scale;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            focus-file := FocusScope {
                                accessible-role: button;
                                accessible-label: @tr("File");
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == " " || event.text == Key.DownArrow) {
                                        menu-file.show({ x: 0px, y: menu-file.height });
                                        return accept;
                                    }
                                    reject
                                }
                                touch-file := TouchArea {
                                    clicked => {
                                        focus-file.focus();
                                        menu-file.show({ x: 0px, y: menu-file.height });
                                    }
                                }
                            }
                        }
                    }
                    menu-downloads := ContextMenuArea {
                        width: heading-downloads.preferred-width + 24px;
                        height: 28px;
                        Menu {
                            title: @tr("Downloads");
                            MenuItem {
                                title: @tr("Resume all");
                                activated => {
                                    root.resume-all();
                                }
                            }
                            MenuItem {
                                title: @tr("Stop all");
                                activated => {
                                    root.stop-all();
                                }
                            }
                            MenuItem {
                                title: @tr("Delete all completed");
                                activated => {
                                    root.delete-completed();
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Find…   Ctrl+F");
                                activated => {
                                    root.find();
                                }
                            }
                            MenuItem {
                                title: @tr("Find next   F3");
                                activated => {
                                    root.find-next();
                                }
                            }
                            MenuSeparator { }
                            Menu {
                                title: @tr("Start queue");
                                for q in root.queues: MenuItem {
                                    title: q.name;
                                    activated => {
                                        root.start-queue(q.id);
                                    }
                                }
                            }
                            Menu {
                                title: @tr("Stop queue");
                                for q in root.queues: MenuItem {
                                    title: q.name;
                                    activated => {
                                        root.stop-queue(q.id);
                                    }
                                }
                            }
                            Menu {
                                title: @tr("Speed Limiter");
                                MenuItem {
                                    // a mark in the name, not "checkable": a checkable item flips by itself
                                    // and then keeps its mark (two marks at once)
                                    title: (root.limiter-on ? "● " : "○ ") + @tr("Turn on");
                                    activated => {
                                        if (!root.limiter-on) {
                                            root.toggle-limiter();
                                        }
                                    }
                                }
                                MenuItem {
                                    title: (!root.limiter-on ? "● " : "○ ") + @tr("Turn off");
                                    activated => {
                                        if (root.limiter-on) {
                                            root.toggle-limiter();
                                        }
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: @tr("Settings…");
                                    activated => {
                                        root.open-limiter();
                                    }
                                }
                            }
                            Menu {
                                title: @tr("When all downloads finish");
                                MenuItem {
                                    title: (root.all-done == 0 ? "● " : "○ ") + @tr("Do nothing");
                                    activated => {
                                        root.set-all-done(0);
                                    }
                                }
                                MenuItem {
                                    title: (root.all-done == 1 ? "● " : "○ ") + @tr("Shut down the computer");
                                    activated => {
                                        root.set-all-done(1);
                                    }
                                }
                                MenuItem {
                                    title: (root.all-done == 2 ? "● " : "○ ") + @tr("Sleep");
                                    activated => {
                                        root.set-all-done(2);
                                    }
                                }
                                MenuItem {
                                    title: (root.all-done == 4 ? "● " : "○ ") + @tr("Hibernate");
                                    activated => {
                                        root.set-all-done(4);
                                    }
                                }
                                MenuItem {
                                    title: (root.all-done == 3 ? "● " : "○ ") + @tr("Exit KeRo Smarter Download");
                                    activated => {
                                        root.set-all-done(3);
                                    }
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Scheduler…");
                                activated => {
                                    root.open-scheduler();
                                }
                            }
                            MenuItem {
                                title: @tr("Options…");
                                activated => {
                                    root.open-settings(0);
                                }
                            }
                        }
                        Rectangle {
                            background: touch-downloads.has-hover || focus-downloads.has-focus ? Theme.hover : transparent;
                            border-radius: 3px;
                            heading-downloads := Text {
                                text: @tr("Downloads");
                                color: Theme.text;
                                font-size: 13px * Theme.font-scale;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            focus-downloads := FocusScope {
                                accessible-role: button;
                                accessible-label: @tr("Downloads");
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == " " || event.text == Key.DownArrow) {
                                        menu-downloads.show({ x: 0px, y: menu-downloads.height });
                                        return accept;
                                    }
                                    reject
                                }
                                touch-downloads := TouchArea {
                                    clicked => {
                                        focus-downloads.focus();
                                        menu-downloads.show({ x: 0px, y: menu-downloads.height });
                                    }
                                }
                            }
                        }
                    }
                    menu-view := ContextMenuArea {
                        width: heading-view.preferred-width + 24px;
                        height: 28px;
                        Menu {
                            title: @tr("View");
                            MenuItem {
                                title: (!root.hide-categories ? "☑ " : "☐ ") + @tr("Show categories");
                                activated => {
                                    root.toggle-categories();
                                }
                            }
                            Menu {
                                title: @tr("Arrange files");
                                for a in [
                                    { key: "added", title: @tr("By order of addition") },
                                    { key: "name", title: @tr("File name") },
                                    { key: "size", title: @tr("Size") },
                                    { key: "status", title: @tr("Status") },
                                    { key: "eta", title: @tr("Time left") },
                                    { key: "speed", title: @tr("Transfer rate") },
                                    { key: "date", title: @tr("Last try date") },
                                    { key: "desc", title: @tr("Description") },
                                    { key: "saveto", title: @tr("Save to") },
                                    { key: "referer", title: @tr("Referer") },
                                    { key: "parent", title: @tr("Parent web page") }
                                ]: MenuItem {
                                    title: (root.sort-by == a.key ? "● " : "○ ") + a.title;
                                    activated => {
                                        root.sort(a.key);
                                    }
                                }
                            }
                            Menu {
                                title: @tr("Toolbar");
                                MenuItem {
                                    title: (!root.toolbar-small ? "● " : "○ ") + @tr("Large buttons");
                                    activated => {
                                        root.set-toolbar-small(false);
                                    }
                                }
                                MenuItem {
                                    title: (root.toolbar-small ? "● " : "○ ") + @tr("Small buttons");
                                    activated => {
                                        root.set-toolbar-small(true);
                                    }
                                }
                            }
                            MenuItem {
                                title: @tr("Columns…");
                                activated => {
                                    root.open-columns();
                                }
                            }
                            Menu {
                                title: @tr("Language");
                                MenuItem {
                                    title: (root.language == "en" ? "● " : "○ ") + "English";
                                    activated => {
                                        root.set-language("en");
                                    }
                                }
                                MenuItem {
                                    title: (root.language == "ar" ? "● " : "○ ") + "العربية";
                                    activated => {
                                        root.set-language("ar");
                                    }
                                }
                                MenuItem {
                                    title: (root.language == "fr" ? "● " : "○ ") + "Français";
                                    activated => {
                                        root.set-language("fr");
                                    }
                                }
                                MenuItem {
                                    title: (root.language == "es" ? "● " : "○ ") + "Español";
                                    activated => {
                                        root.set-language("es");
                                    }
                                }
                                MenuItem {
                                    title: (root.language == "de" ? "● " : "○ ") + "Deutsch";
                                    activated => {
                                        root.set-language("de");
                                    }
                                }
                                MenuItem {
                                    title: (root.language == "pt" ? "● " : "○ ") + "Português";
                                    activated => {
                                        root.set-language("pt");
                                    }
                                }
                                MenuItem {
                                    title: (root.language == "tr" ? "● " : "○ ") + "Türkçe";
                                    activated => {
                                        root.set-language("tr");
                                    }
                                }
                                MenuItem {
                                    title: (root.language == "ru" ? "● " : "○ ") + "Русский";
                                    activated => {
                                        root.set-language("ru");
                                    }
                                }
                            }
                            Menu {
                                title: @tr("Theme");
                                MenuItem {
                                    title: (Theme.mode == 0 ? "● " : "○ ") + @tr("Light");
                                    activated => {
                                        root.set-theme(0);
                                    }
                                }
                                MenuItem {
                                    title: (Theme.mode == 1 ? "● " : "○ ") + @tr("Dark");
                                    activated => {
                                        root.set-theme(1);
                                    }
                                }
                                MenuItem {
                                    title: (Theme.mode == 2 ? "● " : "○ ") + @tr("Ocean blue");
                                    activated => {
                                        root.set-theme(2);
                                    }
                                }
                                MenuItem {
                                    title: (Theme.mode == 3 ? "● " : "○ ") + @tr("Midnight purple");
                                    activated => {
                                        root.set-theme(3);
                                    }
                                }
                                MenuItem {
                                    title: (Theme.mode == 4 ? "● " : "○ ") + @tr("Forest green");
                                    activated => {
                                        root.set-theme(4);
                                    }
                                }
                                MenuItem {
                                    title: (Theme.mode == 5 ? "● " : "○ ") + @tr("Black");
                                    activated => {
                                        root.set-theme(5);
                                    }
                                }
                                MenuItem {
                                    title: (Theme.mode == 6 ? "● " : "○ ") + @tr("Sunset");
                                    activated => {
                                        root.set-theme(6);
                                    }
                                }
                                MenuItem {
                                    title: (Theme.mode == 7 ? "● " : "○ ") + @tr("Teal night");
                                    activated => {
                                        root.set-theme(7);
                                    }
                                }
                                MenuItem {
                                    title: (Theme.mode == 8 ? "● " : "○ ") + @tr("Rose");
                                    activated => {
                                        root.set-theme(8);
                                    }
                                }
                                MenuItem {
                                    title: (Theme.mode == 9 ? "● " : "○ ") + @tr("KeRo Dark");
                                    activated => {
                                        root.set-theme(9);
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: @tr("Appearance…");
                                    activated => {
                                        root.open-settings(9);
                                    }
                                }
                            }
                        }
                        Rectangle {
                            background: touch-view.has-hover || focus-view.has-focus ? Theme.hover : transparent;
                            border-radius: 3px;
                            heading-view := Text {
                                text: @tr("View");
                                color: Theme.text;
                                font-size: 13px * Theme.font-scale;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            focus-view := FocusScope {
                                accessible-role: button;
                                accessible-label: @tr("View");
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == " " || event.text == Key.DownArrow) {
                                        menu-view.show({ x: 0px, y: menu-view.height });
                                        return accept;
                                    }
                                    reject
                                }
                                touch-view := TouchArea {
                                    clicked => {
                                        focus-view.focus();
                                        menu-view.show({ x: 0px, y: menu-view.height });
                                    }
                                }
                            }
                        }
                    }
                    menu-help := ContextMenuArea {
                        width: heading-help.preferred-width + 24px;
                        height: 28px;
                        Menu {
                            title: @tr("Help");
                            MenuItem {
                                title: @tr("Add KeRo Smarter Download to my browser…");
                                activated => {
                                    root.browsers();
                                }
                            }
                            MenuItem {
                                title: @tr("Check for updates (video downloader)");
                                activated => {
                                    root.update-tools();
                                }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("About KeRo Smarter Download");
                                activated => {
                                    root.about();
                                }
                            }
                        }
                        Rectangle {
                            background: touch-help.has-hover || focus-help.has-focus ? Theme.hover : transparent;
                            border-radius: 3px;
                            heading-help := Text {
                                text: @tr("Help");
                                color: Theme.text;
                                font-size: 13px * Theme.font-scale;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            focus-help := FocusScope {
                                accessible-role: button;
                                accessible-label: @tr("Help");
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == " " || event.text == Key.DownArrow) {
                                        menu-help.show({ x: 0px, y: menu-help.height });
                                        return accept;
                                    }
                                    reject
                                }
                                touch-help := TouchArea {
                                    clicked => {
                                        focus-help.focus();
                                        menu-help.show({ x: 0px, y: menu-help.height });
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            // ---- toolbar (buttons that don't fit a narrow window are cut off)
            Rectangle {
                height: root.toolbar-small ? 42px : 64px;
                min-width: 0px;
                clip: true;
                background: @linear-gradient(180deg, Theme.toolbar-top 0%, Theme.toolbar-bottom 100%);
                HRow {
                    padding: 4px;
                    padding-left: Theme.rtl ? (10px) : (6px);
                    padding-right: Theme.rtl ? (6px) : (10px);
                    spacing: 1px;
                    ToolBtn {
                        icon: "add";
                        text: @tr("Add URL");
                        small: root.toolbar-small;
                        clicked => {
                            root.add-url();
                        }
                    }
                    ToolBtn {
                        icon: "batch";
                        text: @tr("Add Batch");
                        small: root.toolbar-small;
                        clicked => {
                            root.add-batch();
                        }
                    }
                    ToolSeparator { }
                    ToolBtn {
                        icon: "resume";
                        text: @tr("Resume");
                        small: root.toolbar-small;
                        enabled: root.can-resume;
                        clicked => {
                            root.resume(root.selected-id);
                        }
                    }
                    ToolBtn {
                        icon: "stop";
                        text: @tr("Stop");
                        small: root.toolbar-small;
                        enabled: root.can-stop;
                        clicked => {
                            root.pause(root.selected-id);
                        }
                    }
                    ToolBtn {
                        icon: "stopall";
                        text: @tr("Stop All");
                        small: root.toolbar-small;
                        clicked => {
                            root.stop-all();
                        }
                    }
                    ToolSeparator { }
                    ToolBtn {
                        icon: "delete";
                        text: @tr("Delete");
                        small: root.toolbar-small;
                        enabled: root.selected-id >= 0;
                        clicked => {
                            root.delete(root.selected-id);
                        }
                    }
                    ToolBtn {
                        icon: "deletedone";
                        text: @tr("Delete Done");
                        small: root.toolbar-small;
                        clicked => {
                            root.delete-completed();
                        }
                    }
                    ToolSeparator { }
                    ToolBtn {
                        icon: "options";
                        text: @tr("Options");
                        small: root.toolbar-small;
                        clicked => {
                            root.open-settings(0);
                        }
                    }
                    ToolBtn {
                        icon: "scheduler";
                        text: @tr("Scheduler");
                        small: root.toolbar-small;
                        clicked => {
                            root.open-scheduler();
                        }
                    }
                    ToolBtn {
                        icon: "limiter";
                        text: root.limiter-on ? @tr("Limiter: On") : @tr("Limiter: Off");
                        small: root.toolbar-small;
                        clicked => {
                            root.toggle-limiter();
                        }
                    }
                    ToolSeparator { }
                    start-q := ToolBtn {
                        icon: "startqueue";
                        text: @tr("Start Queue");
                        small: root.toolbar-small;
                        width: root.toolbar-small ? 34px : 62px;
                        clicked => {
                            root.qmenu-start = true;
                            root.qmenu-x = self.x;
                            queue-menu.show();
                        }
                    }
                    stop-q := ToolBtn {
                        icon: "stopqueue";
                        text: @tr("Stop Queue");
                        small: root.toolbar-small;
                        width: root.toolbar-small ? 34px : 62px;
                        clicked => {
                            root.qmenu-start = false;
                            root.qmenu-x = self.x;
                            queue-menu.show();
                        }
                    }
                    ToolSeparator { }
                    ToolBtn {
                        icon: "grabber";
                        text: @tr("Grabber");
                        small: root.toolbar-small;
                        clicked => {
                            root.grabber();
                        }
                    }
                    ToolBtn {
                        icon: "playlist";
                        text: @tr("Playlist");
                        small: root.toolbar-small;
                        clicked => {
                            root.playlist();
                        }
                    }
                    ToolBtn {
                        icon: "torrent";
                        text: @tr("Torrent");
                        small: root.toolbar-small;
                        clicked => {
                            root.torrent();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        LineEdit {
                            width: 96px;
                            placeholder-text: @tr("Filter the list…");
                            text <=> root.search;
                            edited(t) => {
                                root.search-changed();
                            }
                        }
                    }
                }
                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.line;
                }
            }

            HRow {
                vertical-stretch: 1;
                padding: 4px;
                spacing: 4px;
                // ---- tree
                if !root.hide-categories: Rectangle {
                    width: 210px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line;
                    VerticalLayout {
                        padding: 2px;
                        Rectangle {
                            height: 104px;
                            Image {
                                source: @image-url("kero-logo.png");
                                image-fit: contain;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                        Rectangle {
                            height: 23px;
                            background: Theme.window;
                            Text {
                                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                x: 6px;
                                width: parent.width - 12px;
                                height: parent.height;
                                text: @tr("Categories");
                                vertical-alignment: center;
                                font-size: 12px * Theme.font-scale;
                                font-weight: 600;
                                color: Theme.text;
                            }
                        }
                        Flickable {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                CtxTreeItem {
                                    text: @tr("All Downloads");
                                    icon: "folder";
                                    bold: true;
                                    expandable: true;
                                    expanded: root.open-all;
                                    count: root.count-all;
                                    selected: root.view == "all";
                                    clicked => {
                                        root.view = "all";
                                        root.view-changed(root.view);
                                    }
                                    toggle => {
                                        root.open-all = !root.open-all;
                                    }
                                    builtin: true;
                                    chosen(a) => {
                                        root.category-menu("", a);
                                    }
                                }
                                if root.open-all: VerticalLayout {
                                    for c in root.categories: CtxTreeItem {
                                        text: c.label;
                                        icon: c.kind;
                                        indent: 1;
                                        count: c.count;
                                        target: c.name;
                                        builtin: c.builtin;
                                        selected: root.view == "cat:" + c.name;
                                        clicked => {
                                            root.view = "cat:" + c.name;
                                            root.view-changed(root.view);
                                        }
                                        chosen(a) => {
                                            root.category-menu(c.name, a);
                                        }
                                    }
                                }
                                TreeItem {
                                    text: @tr("Unfinished");
                                    icon: "unfinished";
                                    expandable: true;
                                    expanded: root.open-unf;
                                    count: root.count-unfinished;
                                    selected: root.view == "unfinished";
                                    clicked => {
                                        root.view = "unfinished";
                                        root.view-changed(root.view);
                                    }
                                    toggle => {
                                        root.open-unf = !root.open-unf;
                                    }
                                }
                                if root.open-unf: VerticalLayout {
                                    for c in root.categories: TreeItem {
                                        text: c.label;
                                        icon: c.kind;
                                        indent: 1;
                                        count: c.unfinished;
                                        selected: root.view == "unf:" + c.name;
                                        clicked => {
                                            root.view = "unf:" + c.name;
                                            root.view-changed(root.view);
                                        }
                                    }
                                }
                                TreeItem {
                                    text: @tr("Finished");
                                    icon: "finished";
                                    expandable: true;
                                    expanded: root.open-fin;
                                    count: root.count-finished;
                                    selected: root.view == "finished";
                                    clicked => {
                                        root.view = "finished";
                                        root.view-changed(root.view);
                                    }
                                    toggle => {
                                        root.open-fin = !root.open-fin;
                                    }
                                }
                                if root.open-fin: VerticalLayout {
                                    for c in root.categories: TreeItem {
                                        text: c.label;
                                        icon: c.kind;
                                        indent: 1;
                                        count: c.finished;
                                        selected: root.view == "fin:" + c.name;
                                        clicked => {
                                            root.view = "fin:" + c.name;
                                            root.view-changed(root.view);
                                        }
                                    }
                                }
                                TreeItem {
                                    text: @tr("Queues");
                                    icon: "folder";
                                    bold: true;
                                    expandable: true;
                                    expanded: root.open-queues;
                                    toggle => {
                                        root.open-queues = !root.open-queues;
                                    }
                                    clicked => {
                                        root.open-queues = !root.open-queues;
                                    }
                                }
                                if root.open-queues: VerticalLayout {
                                    for q in root.queues: CtxTreeItem {
                                        is-queue: true;
                                        builtin: q.id == 1;
                                        target: q.name;
                                        text: q.running ? @tr("{} (running)", q.name) : q.name;
                                        icon: "queue";
                                        indent: 1;
                                        count: q.count > 0 ? q.count : "";
                                        selected: root.view == "queue:" + q.id;
                                        clicked => {
                                            root.view = "queue:" + q.id;
                                            root.view-changed(root.view);
                                        }
                                        toggle => {
                                            root.edit-queue(q.id);
                                        }
                                        chosen(a) => {
                                            root.queue-menu-action(q.id, a);
                                        }
                                    }
                                }
                            }
                        }
                        HRow {
                            padding: 4px;
                            spacing: 4px;
                            Button {
                                text: @tr("New queue");
                                horizontal-stretch: 1;
                                clicked => {
                                    root.new-queue();
                                }
                            }
                            Button {
                                text: @tr("Edit");
                                clicked => {
                                    root.edit-queue(root.current-queue);
                                }
                            }
                        }
                    }
                }

                // ---- list (columns that don't fit are cut off on the right)
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 300px;
                    clip: true;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line;
                    VerticalLayout {
                        padding: 1px;
                        Rectangle {
                            height: 24px;
                            background: @linear-gradient(180deg, Theme.header-top 0%, Theme.header-bottom 100%);
                            clip: true;
                            // scrolls sideways together with the list (wide columns)
                            hdr := HRow {
                                x: lv.viewport-x;
                                width: max(parent.width, lv.viewport-width);
                                padding-left: Theme.rtl ? (0px) : (6px);
                                padding-right: Theme.rtl ? (6px) : (0px);
                                HeaderCell {
                                    text: "";
                                    width: 32px;
                                }
                                for c[i] in root.columns: HeaderCell {
                                    width: c.width;
                                    adjustable: true;
                                    text: root.col-title(c.key);
                                    key: root.col-sort-key(c.key);
                                    align: c.key == "size" || c.key == "eta" || c.key == "speed" ? TextHorizontalAlignment.right : c.key == "q" || c.key == "status" || c.key == "last" || c.key == "added" ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
                                    sort-by: root.sort-by;
                                    sort-desc: root.sort-desc;
                                    sort(k) => {
                                        root.sort(k);
                                    }
                                    resized(w) => {
                                        root.column-resized(i, w);
                                    }
                                    resize-done => {
                                        root.columns-changed();
                                    }
                                    dropped(x) => {
                                        // measured from the side where the columns start
                                        root.column-dropped(i, Theme.rtl ? hdr.width - x : x);
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            Rectangle {
                                x: 0;
                                y: parent.height - 1px;
                                width: parent.width;
                                height: 1px;
                                background: Theme.line;
                            }
                        }
                        lv := ListView {
                            vertical-stretch: 1;
                            // Arabic: wide columns start at the right edge, so
                            // the list first shows its right side
                            property <length> rtl-start: Theme.rtl ? min(0px, self.visible-width - self.viewport-width) : 0px;
                            changed rtl-start => {
                                self.viewport-x = self.rtl-start;
                            }
                            init => {
                                self.viewport-x = self.rtl-start;
                            }
                            for r in root.rows: DownloadItem {
                                // every row as wide as its columns: the mouse and
                                // the highlight reach the name in Arabic too
                                width: max(lv.visible-width, self.content-w);
                                data: r;
                                queues: root.queues;
                                cols: root.cols;
                                columns: root.columns;
                                selected: r.sel;
                                sel-count: root.sel-count;
                                pick(ctrl, shift) => {
                                    root.row-clicked(r.id, ctrl, shift);
                                    keys.focus();
                                }
                                right-pick => {
                                    root.row-right(r.id);
                                }
                                drag(offset) => {
                                    root.row-drag(r.id, offset);
                                }
                                drag-out => {
                                    root.row-drag-out(r.id);
                                }
                                activated => {
                                    root.row-activated(r.id);
                                }
                                action(a) => {
                                    root.row-action(r.id, a);
                                }
                                move-to-queue(q) => {
                                    root.row-to-queue(r.id, q);
                                }
                            }
                        }
                    }
                    if root.rows.length == 0: Text {
                        x: 0;
                        y: 120px;
                        width: parent.width;
                        text: root.search != "" ? @tr("Nothing matches “{}”.", root.search) : @tr("No downloads here.\nClick “Add URL”, copy a link, or download something in your browser.");
                        horizontal-alignment: center;
                        color: Theme.muted;
                    }
                }
            }

            // ---- status bar
            Rectangle {
                height: 22px;
                background: Theme.window;
                Rectangle {
                    width: parent.width;
                    height: 1px;
                    y: 0;
                    background: Theme.line;
                }
                HRow {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.status-text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        font-size: 11px * Theme.font-scale;
                        color: Theme.muted;
                    }
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.limiter-text;
                        vertical-alignment: center;
                        font-size: 11px * Theme.font-scale;
                        color: root.limiter-on ? Theme.warn : Theme.muted;
                    }
                }
            }
        }
    }
    // the note of the toolbar button the mouse rests on (drawn above everything)
    Timer {
        interval: 600ms;
        running: ToolTip.pending;
        triggered => {
            ToolTip.pending = false;
            ToolTip.shown = true;
        }
    }
    if ToolTip.shown && ToolTip.text != "": Rectangle {
        x: min(ToolTip.x, root.width - self.width - 6px);
        y: ToolTip.y;
        width: min(320px, tip-box.preferred-width);
        height: tip-box.preferred-height;
        background: Theme.input-bg;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 4px;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000044;
        drop-shadow-offset-y: 2px;
        tip-box := VerticalLayout {
            padding: 8px;
            spacing: 3px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: ToolTip.title;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: ToolTip.text;
                wrap: word-wrap;
                color: Theme.muted;
            }
        }
    }
}

// ------------------------------------------------------------------ dialogs

// "Download File Info" – shown for every new download.
export component AddDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download File Info");
    preferred-width: 640px;
    min-width: 540px;

    in-out property <string> url;
    // full path: folder + file name
    in-out property <string> save-as;
    in-out property <string> description;
    in-out property <int> connections: 32;
    in-out property <int> category-index: 0;
    in-out property <bool> remember-path;
    in property <string> category-name: "General";
    in property <string> kind: "general";
    in property <string> ext;
    in property <string> size-text;
    in property <string> info;
    in property <bool> probing;
    in property <bool> info-error;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in property <[string]> category-names: ["General", "Compressed", "Documents", "Music", "Programs", "Video", "Images"];
    in-out property <bool> use-login;
    in-out property <string> user;
    in-out property <string> password;
    // a warning about the address (web page, duplicate...)
    in property <string> warning;
    // the server refused KeRo Smarter Download: offer the browser instead
    in property <bool> can-use-browser;
    callback use-browser();

    callback check-url();
    callback category-changed(int);
    callback browse();
    callback start-now();
    callback later();
    callback cancel();

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HRow {
            spacing: 14px;
            GridLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 0;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("URL");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HRow {
                    col: Theme.rtl ? 0 : 1;
                    row: 0;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.url;
                        placeholder-text: @tr("https://example.com/file");
                        horizontal-stretch: 1;
                        accepted(t) => {
                            root.check-url();
                        }
                    }
                    Button {
                        text: @tr("Check");
                        clicked => {
                            root.check-url();
                        }
                    }
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 1;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Category");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HRow {
                    col: Theme.rtl ? 0 : 1;
                    row: 1;
                    ComboBox {
                        width: 200px;
                        model: root.category-names;
                        current-index <=> root.category-index;
                        selected(v) => {
                            root.category-changed(root.category-index);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 2;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Save As");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                HRow {
                    col: Theme.rtl ? 0 : 1;
                    row: 2;
                    spacing: 6px;
                    LineEdit {
                        text <=> root.save-as;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "…";
                        clicked => {
                            root.browse();
                        }
                    }
                }
                Rectangle {
                    col: Theme.rtl ? 1 : 0;
                    row: 3;
                }
                CheckBox {
                    col: Theme.rtl ? 0 : 1;
                    row: 3;
                    text: @tr("Remember this path for \"{}\" category", root.category-name);
                    checked <=> root.remember-path;
                }
                Text {
                    col: Theme.rtl ? 1 : 0;
                    row: 4;
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Description");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    col: Theme.rtl ? 0 : 1;
                    row: 4;
                    text <=> root.description;
                    placeholder-text: @tr("optional note");
                }
            }
            VerticalLayout {
                width: 110px;
                spacing: 6px;
                alignment: start;
                padding-top: 4px;
                BigTypeIcon {
                    kind: root.kind;
                    ext: root.ext;
                }
                Text {
                    text: root.size-text;
                    horizontal-alignment: center;
                    font-size: 12px * Theme.font-scale;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }
        HRow {
            spacing: 8px;
            CheckBox {
                text: @tr("Use authorization");
                checked <=> root.use-login;
            }
            if root.use-login: Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Login");
                vertical-alignment: center;
                color: Theme.text;
            }
            if root.use-login: LineEdit {
                text <=> root.user;
                horizontal-stretch: 1;
            }
            if root.use-login: Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Password");
                vertical-alignment: center;
                color: Theme.text;
            }
            if root.use-login: LineEdit {
                text <=> root.password;
                input-type: InputType.password;
                horizontal-stretch: 1;
            }
            if !root.use-login: Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.warning != "": GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 6px;
            Glyph {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                kind: "warn";
            }
            Text {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.warning;
                color: Theme.warn;
                wrap: word-wrap;
                font-size: 12px * Theme.font-scale;
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            height: 32px;
            border-width: 1px;
            border-color: root.info-error ? Theme.err : Theme.line;
            background: Theme.panel;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                vertical-alignment: center;
                text: root.probing ? @tr("Checking the address…") : root.info;
                color: root.info-error ? Theme.err : Theme.muted;
                overflow: elide;
                font-size: 12px * Theme.font-scale;
            }
        }
        HRow {
            spacing: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Connections");
                vertical-alignment: center;
                color: Theme.text;
            }
            SpinBox {
                width: 110px;
                minimum: 1;
                maximum: 32;
                value <=> root.connections;
            }
            Rectangle {
                width: 10px;
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Queue");
                vertical-alignment: center;
                color: Theme.text;
            }
            ComboBox {
                model: root.queue-names;
                current-index <=> root.queue-index;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        HRow {
            spacing: 8px;
            alignment: end;
            if root.can-use-browser: Button {
                text: @tr("Download with the browser");
                clicked => {
                    root.use-browser();
                }
            }
            if root.can-use-browser: Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Download Later");
                enabled: root.url != "";
                clicked => {
                    root.later();
                }
            }
            Button {
                text: @tr("Start Download");
                primary: true;
                enabled: root.url != "";
                clicked => {
                    root.start-now();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 26px;
    width: label.preferred-width + 24px;
    background: root.active ? Theme.panel : ta.has-hover ? Theme.hover : Theme.window;
    border-width: 1px;
    border-color: Theme.line;
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
    }
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px * Theme.font-scale;
        font-weight: root.active ? 600 : 400;
        color: Theme.text;
    }
    if root.active: Rectangle {
        x: 1px;
        y: parent.height - 1px;
        width: parent.width - 2px;
        height: 2px;
        background: Theme.panel;
    }
}

export component BatchDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Add batch download");
    preferred-width: 640px;
    preferred-height: 520px;

    // 0: list of links, 1: address with a * pattern
    in-out property <int> mode: 0;
    in-out property <string> links;
    in-out property <string> folder;
    in property <[string]> queue-names: ["Main queue"];
    in-out property <int> queue-index: 0;
    in-out property <bool> start-now: true;
    in property <string> message;
    // pattern
    in-out property <string> pattern;
    in-out property <bool> letters;
    in-out property <string> from-text: "1";
    in-out property <string> to-text: "10";
    in-out property <int> wildcard-size: 1;
    in-out property <string> user;
    in-out property <string> password;
    in property <string> preview;

    callback paste();
    callback browse();
    callback pattern-changed();
    callback ok();
    callback cancel();

    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HRow {
            spacing: 2px;
            TabButton {
                text: @tr("List of links");
                active: root.mode == 0;
                clicked => {
                    root.mode = 0;
                }
            }
            TabButton {
                text: @tr("Address with a pattern (*)");
                active: root.mode == 1;
                clicked => {
                    root.mode = 1;
                    root.pattern-changed();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        if root.mode == 0: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Paste the links, one per line. They download one after another in the queue you choose.");
                wrap: word-wrap;
                color: Theme.text;
            }
            TextEdit {
                text <=> root.links;
                vertical-stretch: 1;
                min-height: 200px;
                font-size: 12px * Theme.font-scale;
            }
            HRow {
                spacing: 6px;
                Button {
                    text: @tr("Paste from clipboard");
                    clicked => {
                        root.paste();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
        if root.mode == 1: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Type an address with a * where the number (or letter) goes, for example\nhttps://www.site.com/pictures/img*.jpg");
                wrap: word-wrap;
                color: Theme.text;
            }
            LineEdit {
                text <=> root.pattern;
                placeholder-text: @tr("https://www.site.com/pictures/img*.jpg");
                edited(t) => {
                    root.pattern-changed();
                }
            }
            HRow {
                spacing: 16px;
                CheckBox {
                    text: @tr("Letters (a-z) instead of numbers");
                    checked <=> root.letters;
                    toggled => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            HRow {
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("From");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.from-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("To");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    width: 80px;
                    text <=> root.to-text;
                    edited(t) => {
                        root.pattern-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Wildcard size");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                SpinBox {
                    width: 90px;
                    minimum: 1;
                    maximum: 10;
                    value <=> root.wildcard-size;
                    edited(v) => {
                        root.pattern-changed();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Wildcard size 3 makes 001, 002 … 010.");
                color: Theme.muted;
                font-size: 11px * Theme.font-scale;
            }
            HRow {
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Login");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.user;
                    placeholder-text: @tr("optional");
                    horizontal-stretch: 1;
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Password");
                    vertical-alignment: center;
                    color: Theme.text;
                }
                LineEdit {
                    text <=> root.password;
                    input-type: InputType.password;
                    horizontal-stretch: 1;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 80px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    text: root.preview;
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        GridLayout {
            spacing: 8px;
            Text {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Queue");
                vertical-alignment: center;
                color: Theme.text;
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                ComboBox {
                    model: root.queue-names;
                    current-index <=> root.queue-index;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                col: Theme.rtl ? 1 : 0;
                row: 1;
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: @tr("Save all to");
                vertical-alignment: center;
                color: Theme.text;
            }
            HRow {
                col: Theme.rtl ? 0 : 1;
                row: 1;
                spacing: 6px;
                LineEdit {
                    text <=> root.folder;
                    placeholder-text: @tr("automatic (by file type)");
                    horizontal-stretch: 1;
                }
                Button {
                    text: "…";
                    clicked => {
                        root.browse();
                    }
                }
            }
        }
        CheckBox {
            text: @tr("Start the queue now");
            checked <=> root.start-now;
        }
        HRow {
            spacing: 8px;
            Text {
                horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                text: root.message;
                color: Theme.err;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Add");
                primary: true;
                clicked => {
                    root.ok();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

// The per-download progress window (tabs like a classic download manager).
export component DetailsDialog inherits ThemedWindow {
    in property <bool> front;
    in-out property <bool> pinned: false;
    always-on-top: root.front || root.pinned;
    title: root.percent + " " + root.name;
    preferred-width: 980px;
    min-width: 800px;
    preferred-height: 720px;
    no-frame: true;
    in property <bool> known-size;
    in property <bool> folder-available;
    callback maximize();
    in property <string> name;
    in property <string> percent;
    in property <string> url;
    in property <string> status;
    in property <string> size;
    in property <string> downloaded;
    in property <string> speed;
    in property <string> eta;
    in property <string> resumable;
    in property <bool> resumable-ok;
    in property <string> error;
    in property <string> kind: "general";
    in property <float> progress;
    in property <int> state;
    in property <[SegView]> segs;
    in-out property <bool> show-details: true;
    in-out property <int> tab: 0;
    // speed limiter tab
    in-out property <bool> limit-on;
    in-out property <int> limit-kb: 500;
    // options on completion tab
    in-out property <int> when-done: 0;
    in-out property <bool> complete-dialog: true;
    in-out property <bool> force-close;

    callback open-folder();
    callback copy-link();
    callback pause();
    callback resume();
    callback cancel-download();
    callback close-window();
    callback hide-to-tray();
    callback limit-changed();
    callback completion-changed();
    // title bar: move the window / minimize / the X
    callback start-drag();
    callback minimize();
    callback float-download();
    callback close-clicked();
    callback start-resize();
    // "Hide details" / "Show details": the window takes the size it needs
    out property <length> content-height: outer.preferred-height;
    callback details-toggled();


    background: transparent;
    // Static vector geometry. No bitmap screenshot, blur, shader, or animation.
    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 980; viewbox-height: 720;
        commands: "M 12 100 L 112 16 L 268 16 L 285 32 L 465 32 L 486 52 L 718 52 L 742 36 L 941 36 L 970 65 L 970 656 L 940 690 L 680 690 L 662 704 L 50 704 L 12 666 L 12 464 L 24 447 L 24 260 L 12 246 Z";
        fill: #061428; stroke: #006bff; stroke-width: 3px;
    }
    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 980; viewbox-height: 720;
        commands: "M 18 101 L 115 23 L 264 23 L 281 39 L 461 39 L 482 59 L 720 59 L 745 43 L 938 43 L 962 68 L 962 653 L 936 682 L 677 682 L 659 696 L 53 696 L 20 663 L 20 470 L 32 453 L 32 258 L 20 242 Z";
        fill: transparent; stroke: #00d9ff; stroke-width: 1.5px;
    }
    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 980; viewbox-height: 720;
        commands: "M 488 53 L 654 53 L 676 76 M 20 164 L 20 237 M 36 643 L 36 663 L 59 686 L 135 686 M 727 689 L 873 689";
        fill: transparent; stroke: #ffca52; stroke-width: 4px;
    }
    outer := VerticalLayout {
        padding-left: 34px; padding-right: 30px; padding-top: 32px; padding-bottom: 34px;
        spacing: 8px;
        Rectangle {
            height: 84px;
            TouchArea {
                pointer-event(ev) => {
                    if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.start-drag(); }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Image { source: @image-url("kero-logo.png"); width: 98px; height: 82px; image-fit: contain; }
                VerticalLayout {
                    padding-top: 12px; spacing: 0px;
                    Text { text: "KeRo"; color: #eaf6ff; font-size: 38px; font-weight: 800; vertical-alignment: center; }
                    Text { text: "SMARTER DOWNLOAD"; color: #00d9ff; font-size: 13px; font-weight: 700; }
                    Rectangle { height: 2px; background: @linear-gradient(90deg, #00d9ff 0%, #006bff 55%, #061428 100%); }
                }
                Rectangle { horizontal-stretch: 1; }
                ProgressAction { text: "⌖"; selected: root.pinned; min-width: 34px; min-height: 32px; clicked => { root.pinned = !root.pinned; } }
                ProgressAction { text: "◉"; min-width: 34px; min-height: 32px; clicked => { root.float-download(); } }
                ProgressAction { text: "↓"; min-width: 34px; min-height: 32px; clicked => { root.hide-to-tray(); } }
                ProgressAction { text: "−"; min-width: 34px; min-height: 32px; clicked => { root.minimize(); } }
                ProgressAction { text: "□"; min-width: 34px; min-height: 32px; clicked => { root.maximize(); } }
                ProgressAction { text: "×"; min-width: 34px; min-height: 32px; danger: true; clicked => { root.close-clicked(); } }
            }
        }
        Rectangle {
            min-height: 60px;
            background: @linear-gradient(90deg, #0b2a48 0%, #061428 100%);
            border-radius: 8px;
            HorizontalLayout {
                padding: 8px; spacing: 12px;
                TypeIcon { kind: root.kind; width: 40px; height: 40px; }
                VerticalLayout {
                    spacing: 4px; horizontal-stretch: 1;
                    Text { text: root.name; color: #f3f9ff; font-size: 22px * Theme.font-scale; font-weight: 700; overflow: elide; horizontal-alignment: left; }
                    Text { text: root.url; color: #00c9ff; overflow: elide; font-size: 12px * Theme.font-scale; horizontal-alignment: left; }
                }
                ProgressAction { text: "↗"; min-width: 38px; clicked => { root.copy-link(); } }
            }
        }
        HorizontalLayout {
            spacing: 16px;
            Rectangle {
                min-height: 34px; horizontal-stretch: 1;
                border-width: 2px; border-color: #00d9ff; border-radius: 17px;
                background: #08233d; clip: true;
                Rectangle {
                    x: 4px; y: 4px; height: parent.height - 8px;
                    width: max(0px, (parent.width - 8px) * (root.known-size ? max(0, min(root.progress, 1)) : 0));
                    background: root.state == 4 ? @linear-gradient(0deg, #9d2649 0%, #ff4b5c 100%) : root.state == 3 ? @linear-gradient(0deg, #078b72 0%, #32f2a6 100%) : @linear-gradient(0deg, #006bff 0%, #00d9ff 64%, #a3faff 100%);
                    border-radius: 13px;
                }
                if !root.known-size: Text { text: @tr("Unknown"); color: #8fb0d6; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { text: root.percent; color: root.state == 4 ? #ff7483 : #88ebff; font-size: 34px * Theme.font-scale; font-weight: 700; min-width: 132px; horizontal-alignment: center; vertical-alignment: center; }
        }
        HRow {
            spacing: 8px;
            ProgressMetric { label: @tr("Downloaded") + " / " + @tr("File size"); value: root.downloaded + " / " + root.size; horizontal-stretch: 1.7; }
            ProgressMetric { label: @tr("Transfer rate"); value: root.speed; horizontal-stretch: 1; }
            ProgressMetric { label: @tr("Time left"); value: root.eta; horizontal-stretch: 1; }
            ProgressMetric { label: @tr("Resume capability"); value: root.resumable; good: root.resumable-ok; horizontal-stretch: 1; }
        }
        Text { text: root.error != "" ? root.error : root.status; color: root.state == 4 ? #ff8a9a : #a6c4df; font-size: 11px * Theme.font-scale; wrap: word-wrap; horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
        HRow {
            spacing: 8px;
            ProgressAction { text: @tr("Pause"); glyph: "Ⅱ"; enabled: root.state == 0 || root.state == 1; horizontal-stretch: 1; clicked => { root.pause(); } }
            ProgressAction { text: root.state == 3 ? @tr("Close") : @tr("Cancel"); glyph: "×"; danger: true; horizontal-stretch: 1; clicked => { if (root.state == 3) { root.close-window(); } else { root.cancel-download(); } } }
            ProgressAction { text: @tr("Resume"); glyph: "▷"; enabled: root.state == 2 || root.state == 4; horizontal-stretch: 1; clicked => { root.resume(); } }
            ProgressAction { text: @tr("Open folder"); glyph: "▱"; enabled: root.folder-available; horizontal-stretch: 1; clicked => { root.open-folder(); } }
            Rectangle {
                min-width: 165px; horizontal-stretch: 1.5; background: #08233d; border-color: #006bff; border-width: 1px; border-radius: 8px;
                VerticalLayout {
                    padding: 7px; spacing: 4px;
                    Text { text: @tr("Speed Limiter"); color: #cbeaff; horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                    ComboBox {
                        model: [@tr("Unlimited"), "128 KB/s", "512 KB/s", "1 MB/s", "2 MB/s", @tr("Custom")];
                        current-index: !root.limit-on ? 0 : root.limit-kb == 128 ? 1 : root.limit-kb == 512 ? 2 : root.limit-kb == 1024 ? 3 : root.limit-kb == 2048 ? 4 : 5;
                        selected(v) => {
                            if (v == 5) { root.tab = 1; }
                            else { root.limit-on = v != 0; root.limit-kb = v == 1 ? 128 : v == 2 ? 512 : v == 3 ? 1024 : v == 4 ? 2048 : root.limit-kb; root.limit-changed(); }
                        }
                    }
                }
            }
            Rectangle {
                min-width: 190px; horizontal-stretch: 1.6; background: #08233d; border-color: #006bff; border-width: 1px; border-radius: 8px;
                VerticalLayout {
                    padding: 7px; spacing: 4px;
                    Text { text: @tr("Options on completion"); color: #cbeaff; horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                    ComboBox {
                        model: [@tr("Do nothing (keep the computer on)"), @tr("Shut down the computer"), @tr("Sleep"), @tr("Exit KeRo Smarter Download"), @tr("Hibernate")];
                        current-index <=> root.when-done;
                        selected(v) => { root.completion-changed(); }
                    }
                }
            }
        }
        HRow {
            spacing: 5px;
            ProgressAction { text: @tr("Download status"); selected: root.tab == 0; horizontal-stretch: 1; min-height: 25px; clicked => { root.tab = 0; } }
            ProgressAction { text: @tr("Speed Limiter"); selected: root.tab == 1; horizontal-stretch: 1; min-height: 25px; clicked => { root.tab = 1; } }
            ProgressAction { text: @tr("Options on completion"); selected: root.tab == 2; horizontal-stretch: 1; min-height: 25px; clicked => { root.tab = 2; } }
            ProgressAction { text: root.show-details ? @tr("<< Hide details") : @tr("Show details >>"); min-height: 25px; clicked => { root.show-details = !root.show-details; root.details-toggled(); } }
        }
        if root.tab != 0: Rectangle {
            background: Theme.panel; border-radius: 5px;
            border-color: #1a5278; border-width: 1px;
                        if root.tab == 1: VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                HRow {
                    spacing: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Transfer rate");
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.speed;
                        color: Theme.text;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                CheckBox {
                    text: @tr("Use speed limiter for this download");
                    checked <=> root.limit-on;
                    toggled => {
                        root.limit-changed();
                    }
                }
                HRow {
                    spacing: 8px;
                    Text {
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Maximum download speed (KB/s)");
                        color: root.limit-on ? Theme.text : Theme.muted;
                        vertical-alignment: center;
                    }
                    SpinBox {
                        width: 140px;
                        enabled: root.limit-on;
                        minimum: 1;
                        maximum: 1000000;
                        step-size: 50;
                        value <=> root.limit-kb;
                        edited(v) => {
                            root.limit-changed();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                HRow {
                    spacing: 6px;
                    for kb in [128, 256, 512, 1024, 2048, 5120]: Button {
                        text: kb >= 1024 ? @tr("{} MB/s", kb / 1024) : @tr("{} KB/s", kb);
                        clicked => {
                            root.limit-on = true;
                            root.limit-kb = kb;
                            root.limit-changed();
                        }
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Changes apply right away, even while downloading.");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                }
            }
            if root.tab == 2: VerticalLayout {
                padding: 14px;
                spacing: 12px;
                alignment: start;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("When this download completes:");
                    color: Theme.text;
                }
                ComboBox {
                    width: 300px;
                    model: [@tr("Do nothing (keep the computer on)"), @tr("Shut down the computer"), @tr("Sleep"), @tr("Exit KeRo Smarter Download"), @tr("Hibernate")];
                    current-index <=> root.when-done;
                    selected(v) => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Force programs to close when shutting down");
                    checked <=> root.force-close;
                    enabled: root.when-done == 1;
                    toggled => {
                        root.completion-changed();
                    }
                }
                CheckBox {
                    text: @tr("Show the \"Download complete\" window");
                    checked <=> root.complete-dialog;
                    toggled => {
                        root.completion-changed();
                    }
                }
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("You get 30 seconds to cancel before the computer shuts down, sleeps or hibernates.");
                    font-size: 11px * Theme.font-scale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
            }
        }
        if root.show-details: VerticalLayout {
            spacing: 7px;
            Rectangle {
                height: 32px; background: #041020; border-width: 1px; border-color: #164566; border-radius: 6px;
                HRow {
                    padding: 6px; spacing: 12px;
                    Text { text: @tr("Connection activity"); color: #d5e8fa; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1; background: #081f36; clip: true;
                        // Live byte ranges only; neither random nor time-driven bars.
                        for seg in root.segs: Rectangle {
                            x: (parent.width - 2px) * seg.start; y: 1px;
                            width: max(0px, (parent.width - 2px) * (seg.done - seg.start)); height: parent.height - 2px;
                            background: seg.busy ? #00d9ff : #006bff;
                        }
                        for seg in root.segs: Rectangle { x: (parent.width - 2px) * seg.start; width: 1px; height: parent.height; background: #ffca52; }
                    }
                }
            }
            Rectangle {
                min-height: 142px; vertical-stretch: 1; background: #041325; border-width: 1px; border-color: #167cb0; border-radius: 8px;
                VerticalLayout {
                    padding: 5px; spacing: 0px;
                    Rectangle {
                        height: 28px; background: @linear-gradient(0deg, #08213a 0%, #103a60 100%);
                        HRow {
                            Text { text: @tr("N."); width: 34px; color: #d9edff; horizontal-alignment: center; vertical-alignment: center; }
                            Text { text: @tr("Downloaded"); width: 108px; color: #d9edff; horizontal-alignment: center; vertical-alignment: center; }
                            Text { text: @tr("Info"); horizontal-stretch: 1; color: #d9edff; horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; vertical-alignment: center; }
                            Text { text: @tr("Progress"); width: 145px; color: #d9edff; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    if root.segs.length == 0: Text { text: @tr("No connection details available"); color: #8fb0d6; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 1; }
                    ListView {
                        vertical-stretch: 1;
                        for seg[index] in root.segs: Rectangle {
                            height: 29px; background: mod(index, 2) == 0 ? #0b2238 : #06182b;
                            HRow {
                                Text { text: seg.number; width: 34px; color: #edf7ff; horizontal-alignment: center; vertical-alignment: center; }
                                Text { text: seg.downloaded; width: 108px; color: #edf7ff; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                                Text { text: seg.info; horizontal-stretch: 1; color: seg.busy ? #00d9ff : #9cb9d3; horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; vertical-alignment: center; overflow: elide; }
                                Rectangle {
                                    width: 145px;
                                    Rectangle { x: 7px; y: 8px; width: parent.width - 14px; height: 13px; background: #12304a; border-radius: 3px;
                                        Rectangle { width: parent.width * max(0, min(seg.fraction, 1)); height: parent.height; border-radius: 3px; background: @linear-gradient(90deg, #00d9ff 0%, #006bff 100%); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    Rectangle {
        x: root.width - 22px; y: root.height - 22px; width: 18px; height: 18px;
        TouchArea { mouse-cursor: nwse-resize; pointer-event(ev) => { if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) { root.start-resize(); } } }
    }
}

export component CompleteDialog inherits ThemedWindow {
    // set for a moment so the window comes in front of the browser
    in property <bool> front;
    always-on-top: root.front;
    title: @tr("Download complete");
    preferred-width: 540px;

    in property <string> name;
    in property <string> size;
    in property <string> path;
    in property <string> url;
    in property <string> kind: "general";
    in property <string> ext;
    in-out property <bool> dont-show;

    callback open-file();
    callback open-with();
    callback open-folder();
    callback close-window();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        GridLayout {
            // a row that reads from right to left in Arabic (wrapped text needs a grid)
            spacing: 16px;
            BigTypeIcon {
                col: Theme.rtl ? 1 : 0;
                row: 0;
                kind: root.kind;
                ext: root.ext;
            }
            VerticalLayout {
                col: Theme.rtl ? 0 : 1;
                row: 0;
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                    text: @tr("Download complete");
                    font-size: 15px * Theme.font-scale;
                    font-weight: 700;
                    color: Theme.ok;
                }
                GridLayout {
                    spacing: 6px;
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 0;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Address");
                        color: Theme.muted;
                    }
                    Text {
                        col: Theme.rtl ? 0 : 1;
                        row: 0;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.url;
                        overflow: elide;
                        font-size: 11px * Theme.font-scale;
                        color: Theme.accent;
                    }
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 1;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("File size");
                        color: Theme.muted;
                    }
                    Text {
                        col: Theme.rtl ? 0 : 1;
                        row: 1;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.size;
                        color: Theme.text;
                    }
                    Text {
                        col: Theme.rtl ? 1 : 0;
                        row: 2;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: @tr("Saved as");
                        color: Theme.muted;
                    }
                    Text {
                        col: Theme.rtl ? 0 : 1;
                        row: 2;
                        horizontal-alignment: Theme.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        text: root.path;
                        wrap: word-wrap;
                        font-size: 11px * Theme.font-scale;
                        color: Theme.text;
                    }
                }
            }
        }
        HRow {
            spacing: 8px;
            CheckBox {
                text: @tr("Don't show this again");
                checked <=> root.dont-show;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Open");
                primary: true;
                clicked => {
                    root.open-file();
                }
            }
            // no "Open with…" here: picked by mistake it changes which
            // program opens this kind of file (still in the list's menu)
            Button {
                text: @tr("Open folder");
                clicked => {
                    root.open-folder();
                }
            }
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-window();
                }
            }
        }
    }
}
