// Live download badge: the percentage is text, never baked into the logo.


component BadgeButton inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    callback clicked();
    width: 24px; height: 24px;
    border-radius: 12px;
    background: touch.has-hover ? #07567b : #071e36;
    border-width: 1px; border-color: #25cbe8;
    Text {
        text: root.label; color: #8af6ff; font-size: 15px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    if touch.has-hover: Rectangle {
        x: -45px; y: -28px; width: 132px; height: 24px;
        background: #071e36; border-radius: 5px;
        Text { text: root.hint; font-size: 10px; color: #8af6ff;
            horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    }
}

export component FloatingDownload inherits Window {
    title: root.percent + " · " + root.name;
    icon: @image-url("icon-window.png");
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in-out property <bool> compact: false;
    in-out property <bool> completion-shown: false;
    in property <string> name;
    in property <string> percent: "0%";
    in property <float> progress;
    in property <int> state;
    in property <bool> rtl;
    width: root.compact ? 116px : 204px;
    height: root.width + 30px;
    callback restore();
    callback resize-badge();
    callback to-tray();
    callback start-drag();
    callback toggle-pause();

    disc := Rectangle {
        x: 4px; y: 4px;
        width: root.width - 8px; height: self.width;
        border-radius: self.width / 2;
        background: @linear-gradient(135deg, #133d63 0%, #031025 100%);
        border-width: 2px; border-color: #b9964f;
        Path {
            width: parent.width; height: parent.height;
            viewbox-width: 200; viewbox-height: 200;
            commands: "M 100 9 A 91 91 0 1 1 100 191 A 91 91 0 1 1 100 9";
            fill: transparent; stroke: #164465; stroke-width: 9px;
        }
        if root.progress >= 0.01: Path {
            width: parent.width; height: parent.height;
            viewbox-width: 200; viewbox-height: 200;
            commands: "M 100.0000 9.0000 A 91 91 0 0 1 105.7139 9.1796";
            fill: transparent; stroke: #17deff; stroke-width: 9px;
        }
