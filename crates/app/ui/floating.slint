        }
        Image {
            source: @image-url("icon-window.png");
            x: parent.width * 0.22; y: parent.height * 0.13;
            width: parent.width * 0.56; height: parent.height * 0.56;
            image-fit: contain;
            // The K artwork from our existing transparent brand asset.
            source-clip-x: 28; source-clip-y: 12;
            source-clip-width: 205; source-clip-height: 161;
        }
        Rectangle {
            x: parent.width * 0.18; y: parent.height * 0.64;
            width: parent.width * 0.64; height: parent.height * 0.23;
            border-radius: self.height / 2;
            background: #031428;
            Text {
                text: root.percent;
                color: #43edff;
                font-size: root.compact ? 22px : 38px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        TouchArea {
            pointer-event(ev) => {
                if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                    root.start-drag();
                }
            }
        }

    }
    HorizontalLayout {
        x: (root.width - 104px) / 2; y: root.width;
        width: 104px; height: 24px; spacing: 2px;
        BadgeButton {
            label: "↗";
            hint: root.rtl ? "إظهار تفاصيل التحميل" : "Restore download details";
            clicked => { root.restore(); }
        }
        BadgeButton {
            label: root.compact ? "+" : "−";
            hint: root.rtl ? "تغيير حجم اللوجو" : "Change logo size";
            clicked => { root.resize-badge(); }
        }
        BadgeButton {
            label: root.state == 2 || root.state == 4 ? "▶" : "Ⅱ";
            hint: root.rtl ? "إيقاف مؤقت / استئناف" : "Pause / resume";
            clicked => { root.toggle-pause(); }
        }
        BadgeButton {
            label: "_";
            hint: root.rtl ? "تصغير بجوار الساعة" : "Hide next to the clock";
            clicked => { root.to-tray(); }
        }
    }
}
