// Static vector skin: no blur, drop shadows, animations or polling timers.
import { Theme, Glyph } from "common.slint";

export global ProgressPalette {
    in-out property <color> accent: #00d9ff;
    in-out property <color> secondary: #006bff;
    in-out property <color> surface: #061428;
    out property <color> panel: surface.mix(accent, 0.08);
    out property <color> raised: surface.mix(accent, 0.18);
    out property <color> line: surface.mix(accent, 0.45);
}

export component ProgressAction inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    forward-focus: focus;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <bool> selected;
    out property <bool> hovered: hit.has-hover;
    callback clicked();
    min-width: 66px;
    min-height: 44px;
    border-radius: 8px;
    border-width: 1px;
    border-color: !root.enabled ? #52657b : root.danger ? #f16a7b : ProgressPalette.accent;
    background: !root.enabled ? ProgressPalette.surface : root.danger ? (hit.pressed ? #882c42 : #661f36) : hit.pressed ? ProgressPalette.raised.brighter(0.2) : root.selected || hit.has-hover ? ProgressPalette.raised : @linear-gradient(0deg, ProgressPalette.panel 0%, ProgressPalette.raised 100%);
    VerticalLayout {
        padding: 5px;
        spacing: 1px;
        if root.glyph != "": Rectangle {
            height: 22px;
            Glyph {
                x: (parent.width - self.width) / 2;
                width: 20px; height: 20px;
                kind: root.glyph;
                tint: root.enabled ? #e6faff : #72849b;
            }
        }
        if root.text != "":         Text {
            text: root.text;
            color: root.enabled ? #f0f7ff : #59728b;
            font-size: 13px * Theme.font-scale;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    hit := TouchArea {
        width: parent.width; height: parent.height;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
    // Preserve keyboard activation and a visible focus indicator.
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    if focus.has-focus: Rectangle {
        x: 3px; y: 3px;
        width: parent.width - 6px; height: parent.height - 6px;
        border-width: 1px; border-color: #ffdb76; border-radius: 4px;
        background: transparent;
    }
}

export component ProgressMetric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> good;
    background: ProgressPalette.panel;
    border-width: 1px;
    border-color: ProgressPalette.line;
    border-radius: 5px;
    min-height: 54px;
    VerticalLayout {
        padding: 7px;
        spacing: 2px;
        Text {
            text: root.label; color: #9cb9d3;
            font-size: 11px * Theme.font-scale;
            horizontal-alignment: center;
        }
        Text {
            text: root.value; color: root.good ? #40e8a6 : #edf7ff;
            font-size: 16px * Theme.font-scale;
            font-weight: 600; horizontal-alignment: center;
            overflow: elide;
        }
    }
}
